generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Вернули обратно!
}

model Job {
  id        String   @id @default(uuid())
  url       String
  status    String   @default("pending")
  progress  Int      @default(0)
  message   String?
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reference {
  id        String   @id @default(uuid())
  name      String
  url       String
  data      Json
  createdAt DateTime @default(now())
}
